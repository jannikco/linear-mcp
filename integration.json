    "tools": [
      {
        "name": "get_viewer",
        "description": "Read the authenticated Linear user through a fixed GraphQL query.",
        "method": "POST",
        "path": "/graphql",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {}
        },
        "sampleArguments": {},
        "provenance": [
          "https://linear.app/developers/graphql"
        ],
        "body": {
          "query": "query Viewer { viewer { id name email } }"
        }
      },
      {
        "name": "list_issues",
        "description": "Read a bounded page of issues using GraphQL variables.",
        "method": "POST",
        "path": "/graphql",
        "readOnly": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "first": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "after": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Identifier"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {
            "first": "variables.first",
            "after": "variables.after"
          }
        },
        "sampleArguments": {
          "first": 10
        },
        "provenance": [
          "https://linear.app/developers/graphql"
        ],
        "body": {
          "query": "query Issues($first: Int = 20, $after: String) { issues(first: $first, after: $after) { nodes { id identifier title } pageInfo { hasNextPage endCursor } } }"
        },
        "pagination": {
          "type": "cursor",
          "cursorInput": "after",
          "nextCursorPath": "data.issues.pageInfo.endCursor",
          "hasMorePath": "data.issues.pageInfo.hasNextPage"
        }
      }
    ],
